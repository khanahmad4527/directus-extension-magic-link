{
	"name": "directus-extension-magic-link",
	"description": "Passwordless magic-link login for Directus that follows the core login rules (user status, provider, 2FA, sessions), with Liquid email templates and pluggable validation.",
	"version": "1.0.0",
	"license": "MIT",
	"author": "Ahmad Khan <khanahmad4527@gmail.com>",
	"icon": "mail_lock",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"magic-link",
		"passwordless"
	],
	"type": "module",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "endpoint",
				"name": "magic-link",
				"source": "src/endpoint/index.ts"
			},
			{
				"type": "hook",
				"name": "magic-link-setup",
				"source": "src/hook/index.ts"
			}
		],
		"host": ">=11.0.0 <13.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "scripts/e2e.sh",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@directus/errors": "2.5.2",
		"liquidjs": "10.29.0",
		"ms": "2.1.3"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.5",
		"@directus/types": "17.0.0",
		"@eslint/js": "10.0.1",
		"@types/express": "4.17.21",
		"@types/ms": "2.1.0",
		"@types/node": "22.20.4",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.12.0",
		"knex": "3.1.0",
		"pino": "9.7.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.1",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"ignoredBuiltDependencies": [
			"vue-demi"
		]
	}
}
